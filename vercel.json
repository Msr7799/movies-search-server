{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/api/discover", "destination": "/api/index?route=search" },
    { "source": "/api/suggest", "destination": "/api/index?route=suggestions" },
    { "source": "/api/v1/:path*", "destination": "/api/index?route=:path*" },
    { "source": "/api/admin/:path*", "destination": "/api/admin?route=:path*" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 60 },
    "api/admin.ts": { "maxDuration": 30 },
    "api/openapi.ts": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
