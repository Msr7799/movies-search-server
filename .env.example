# Required server-only keys. Never use NEXT_PUBLIC_ names.
TAVILY_API_KEY=
SERPER_API_KEY=
GEMINI_API_KEY=
GEMINI_AUTO_SUGGESTED_API_KEY=

# Movie detail enrichment. Supply either the TMDB v4 read token or v3 API key.
API_READ_AUTH_TOKEN=
TMDB_API_KEY=

# Admin dashboard. Password must be 12+ characters; session secret must be 32+.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Persistent central settings, providers and public HLS catalog.
MONGODB_URI=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=any_movie_control

# Stable model fallbacks, tried from left to right.
GEMINI_SEARCH_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
GEMINI_SUGGEST_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Comma-separated web origins. Native Android/iOS clients normally send no Origin.
ALLOWED_ORIGINS=https://your-web-app.vercel.app

# Optional distributed cache/rate limiting. Strongly recommended on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cost and abuse controls. These do not restrict which public domains can be searched.
SEARCH_LIMIT_PER_10_MINUTES=20
SUGGEST_LIMIT_PER_MINUTE=20
SEARCH_CACHE_SECONDS=21600
SUGGEST_CACHE_SECONDS=86400

# Tavily general-web search. No include_domains/exclude_domains provider list is used.
# The exact user query is sent with advanced depth in code; fallback variants use this depth.
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=20

# Tavily crawl fallback. It may return external links; every URL is still verified by
# the app's HTTPS/SSRF/media checks before it is treated as playable.
TAVILY_CRAWL_ROOTS=3
TAVILY_CRAWL_LIMIT=24
TAVILY_CRAWL_DEPTH=2
TAVILY_CRAWL_BREADTH=20
TAVILY_CRAWL_TIMEOUT_SECONDS=35
TAVILY_CRAWL_EXTRACT_DEPTH=basic

# Optional hint only; leave blank for global search behavior.
APP_REGION=

# The media inspector accepts public HTTP/HTTPS destinations, blocks local/private IPs,
# limits redirects/bytes/time, and does not bypass authentication, paywalls, or DRM.
